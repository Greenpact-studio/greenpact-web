# Site statique Greenpact (Next.js export). Ce fichier remplace celui de WordPress.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Scripts et styles : noms hachés à chaque build, cache long et immuable.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Pages et données de navigation : toujours revalidées, pour que chaque
  # onglet charge la version courante après un déploiement.
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Images : cache d'un mois (remplacer une image = changer son nom).
  <FilesMatch "\.(webp|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Anciennes adresses WordPress → nouvelles pages.
  RewriteRule ^notre-equipe/?$ /equipe/ [R=301,L]
  RewriteRule ^nos-realisations/?$ /portfolio/ [R=301,L]
  RewriteRule ^avec-qui/?$ /portfolio/ [R=301,L]
  RewriteRule ^notre-actualite/?$ /actualites/ [R=301,L]
  RewriteRule ^nos-defis/?$ /these-impact/ [R=301,L]
  RewriteRule ^comment/?$ / [R=301,L]
  RewriteRule ^contact/?$ /devenir-investisseur/ [R=301,L]
  # Plus de WordPress : ses pages d'administration renvoient à l'accueil.
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php) / [R=301,L]
</IfModule>
