# Site statique Greenpact (Next.js export). Ce fichier remplace celui de WordPress.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # En-têtes de sécurité (toutes les réponses, y compris redirections et erreurs).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # CSP en observation : elle signale dans la console sans rien bloquer.
  # Après une semaine sans alerte, remplacer « Content-Security-Policy-Report-Only »
  # par « Content-Security-Policy ».
  # Domaines tiers : cdn.jsdelivr.net (client Supabase de /actionnaires/),
  # fonts.googleapis.com / fonts.gstatic.com (polices de /actionnaires/),
  # *.supabase.co en https et wss (données et temps réel de /actionnaires/),
  # youtube-nocookie.com, embed.podcasts.apple.com, linkedin.com (lecteurs intégrés).
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src 'self' https://www.youtube-nocookie.com https://embed.podcasts.apple.com https://www.linkedin.com; media-src 'self' https:; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

  # Scripts et styles : noms hachés à chaque build, cache long et immuable.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Pages et données de navigation : toujours revalidées, pour que chaque
  # onglet charge la version courante après un déploiement.
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Images : le navigateur garde sa copie mais redemande au serveur si elle a
  # changé (réponse 304 légère sinon). Une image remplacée sous le même nom
  # apparaît donc dès le déploiement suivant.
  <FilesMatch "\.(webp|jpe?g|png|svg|ico)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Une seule adresse canonique : https://www.greenpact.fr (certificat OVH Let's Encrypt).
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.greenpact\.fr$ [NC]
  RewriteRule ^(.*)$ https://www.greenpact.fr/$1 [R=301,L]
  # Anciennes adresses WordPress → nouvelles pages.
  RewriteRule ^notre-equipe/?$ https://www.greenpact.fr/equipe/ [R=301,L]
  RewriteRule ^nos-realisations/?$ https://www.greenpact.fr/portfolio/ [R=301,L]
  RewriteRule ^avec-qui/?$ https://www.greenpact.fr/portfolio/ [R=301,L]
  RewriteRule ^notre-actualite/?$ https://www.greenpact.fr/actualites/ [R=301,L]
  RewriteRule ^nos-defis/?$ https://www.greenpact.fr/these-impact/ [R=301,L]
  RewriteRule ^comment/?$ https://www.greenpact.fr/ [R=301,L]
  RewriteRule ^contact/?$ https://www.greenpact.fr/devenir-investisseur/ [R=301,L]
  # L'ancienne page de présentation de l'espace investisseur mène à la connexion.
  RewriteRule ^espace-investisseur/?$ https://www.greenpact.fr/actionnaires/ [R=301,L]
  # Plus de WordPress : ses pages d'administration renvoient à l'accueil.
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php) https://www.greenpact.fr/ [R=301,L]
</IfModule>
